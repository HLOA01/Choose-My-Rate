# Frontend-only Vite variables can go here.
# Do not put OPENAI_API_KEY in this browser app.
VITE_APP_ENV=local
VITE_SALLY_API_URL=
VITE_PRICING_ENGINE_API_URL=
VITE_SALLY_VOICE_API_URL=

# HLOA platform integration (PASS 3). When set, the borrower funnel obtains
# canonical Lead / Borrower / Scenario ids from HLOA Lead Engine and emits
# funnel events. Leave empty to disable the integration entirely.
VITE_HLOA_LEAD_ENGINE_URL=
VITE_HLOA_ACTOR_ID=svc:choose-my-rate
